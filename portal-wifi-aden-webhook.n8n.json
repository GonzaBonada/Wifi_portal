        1100,
        -100
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.unifiUrl }}/proxy/network/api/s/{{ $('Config').item.json.unifiSite }}/cmd/stamgr",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Cookie",
              "value": "={{ $json.cookie }}"
            },
            {
              "name": "X-CSRF-Token",
              "value": "={{ $json.csrf }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ cmd: 'authorize-guest', mac: $('Config').item.json.mac, minutes: $('Config').item.json.minutos, ap_mac: $('Config').item.json.ap || undefined }) }}",
        "options": {
          "allowUnauthorizedCerts": true,
          "timeout": 10000
        }
      }
