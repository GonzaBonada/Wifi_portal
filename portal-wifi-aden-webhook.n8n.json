    {
      "id": "1fffed18-f1ec-4d9a-a0a7-2dbab836e8df",
      "name": "Login UniFi",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        -100
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.unifiUrl }}/api/auth/login",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ username: $('Config').item.json.unifiUser, password: $('Config').item.json.unifiPass, remember: false }) }}",
        "options": {
          "allowUnauthorizedCerts": true,
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      }
    },
    {
      "id": "6c3b6042-c8e3-4237-ba04-e044b4f9588a",
      "name": "Extraer sesión",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -100
      ],
      "parameters": {
        "jsCode": "const h = $json.headers || {};\nlet cookies = h['set-cookie'] || [];\nif (!Array.isArray(cookies)) cookies = [cookies];\nconst cookie = cookies.map(c => c.split(';')[0]).join('; ');\nreturn [{ json: { cookie, csrf: h['x-csrf-token'] || '' } }];"
      }
    },
    {
      "id": "55149e5d-03e3-4f55-b601-eff38685bf61",
